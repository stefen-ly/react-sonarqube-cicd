
# syntax=docker/dockerfile:1

# Stage 1 - Build React on native build architecture
FROM --platform=$BUILDPLATFORM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY . .

RUN npm run build

# Stage 2 - Multi-platform production image
FROM nginx:alpine

COPY --from=build /app/build /usr/share/nginx/html

COPY nginx.multi-agent.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
