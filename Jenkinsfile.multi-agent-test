
pipeline {
    agent none

    options {
        skipDefaultCheckout(true)
    }

    stages {
        stage('React CI + SonarQube') {
            agent { label 'build' }

            stages {
                stage('Checkout') {
                    steps {
                        checkout scm
                    }
                }

                stage('Verify Build Agent') {
                    steps {
                        sh '''
                            hostname
                            node -v
                            npm -v
                            sonar-scanner --version
                        '''
                    }
                }

                stage('Install Dependencies') {
                    steps {
                        sh 'npm ci'
                    }
                }

                stage('Build React') {
                    steps {
                        sh 'npm run build'
                    }
                }

                stage('Verify Build') {
                    steps {
                        sh 'test -d build'
                    }
                }

                stage('SonarQube Analysis') {
                    steps {
                        withSonarQubeEnv('SonarQube-Agent-Lab') {
                            sh '''
                                sonar-scanner \
                                  -Dsonar.projectKey=jenkins-multi-agent-lab \
                                  -Dsonar.sources=src \
                                  -Dsonar.exclusions="**/node_modules/**,**/build/**" \
                                  -Dsonar.host.url="$SONAR_HOST_URL" \
                                  -Dsonar.token="$SONAR_AUTH_TOKEN"
                            '''
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
    }

    post {
        success {
            echo 'REACT BUILD + SONARQUBE QUALITY GATE PASSED'
        }

        failure {
            echo 'REACT MULTI-AGENT CI FAILED'
        }
    }
}
