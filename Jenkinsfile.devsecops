
pipeline {
    agent none

    parameters {
        booleanParam(
            name: 'DEPLOY_PRODUCTION',
            defaultValue: false,
            description: 'Deploy to AWS Production after manual approval'
        )
    }

    environment {
        IMAGE = 'stefenly19/react-multi-agent'
        TAG = "${BUILD_NUMBER}"
        AWS_HOST = '52.221.253.109'
        AWS_USER = 'ubuntu'
    }

    stages {

        stage('1. SonarQube') {
            agent { label 'build' }

            steps {
                checkout scm

                withSonarQubeEnv('SonarQube-Agent-Lab') {
                    sh '''
                        sonar-scanner \
                          -Dsonar.projectKey=jenkins-multi-agent-lab \
                          -Dsonar.sources=src \
                          -Dsonar.host.url="$SONAR_HOST_URL" \
                          -Dsonar.token="$SONAR_AUTH_TOKEN"
                    '''
                }
            }
        }

        stage('2. Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('3. Trivy Security Scan') {
            agent { label 'build' }

            steps {
                checkout scm

                sh '''
                    set -eu

                    mkdir -p trivy-reports .trivy-cache

                    docker run --rm \
                      --user "$(id -u):$(id -g)" \
                      -e HOME=/app \
                      -v "$PWD:/app" \
                      -w /app \
                      aquasec/trivy:0.76.2 \
                      fs \
                      --cache-dir /app/.trivy-cache \
                      --scanners vuln,secret \
                      --severity HIGH,CRITICAL \
                      --skip-dirs node_modules \
                      --skip-dirs .trivy-cache \
                      --exit-code 1 \
                      --format json \
                      --output trivy-reports/report.json \
                      .
                '''
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'trivy-reports/report.json',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        stage('4. Build React') {
            agent { label 'build' }

            steps {
                checkout scm

                sh '''
                    set -eu
                    npm ci
                    npm run build
                '''
            }
        }

        stage('5. Docker Build & Push') {
            agent { label 'build' }

            steps {
                checkout scm

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-multi-agent',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        # Preserve existing Buildx configuration.
                        # Only redirect Docker login credentials to a
                        # temporary configuration directory.
                        ORIGINAL_DOCKER_CONFIG="${DOCKER_CONFIG:-$HOME/.docker}"
                        TEMP_DOCKER_CONFIG="$(mktemp -d)"

                        trap 'rm -rf "$TEMP_DOCKER_CONFIG"' EXIT

                        printf '%s' "$DOCKER_PASS" | \
                          DOCKER_CONFIG="$TEMP_DOCKER_CONFIG" \
                          docker login \
                            -u "$DOCKER_USER" \
                            --password-stdin

                        # Verify the existing Jenkins Buildx builder.
                        DOCKER_CONFIG="$ORIGINAL_DOCKER_CONFIG" \
                          docker buildx inspect \
                            multi-agent-builder --bootstrap

                        # Build and push using the temporary login config.
                        # Copy Buildx metadata so the builder remains visible.
                        if [ -d "$ORIGINAL_DOCKER_CONFIG/buildx" ]; then
                            cp -R "$ORIGINAL_DOCKER_CONFIG/buildx" \
                              "$TEMP_DOCKER_CONFIG/buildx"
                        fi

                        DOCKER_CONFIG="$TEMP_DOCKER_CONFIG" \
                          docker buildx build \
                            --builder multi-agent-builder \
                            --platform linux/amd64,linux/arm64 \
                            -f Dockerfile.multi-agent \
                            -t "$IMAGE:$TAG" \
                            --push .
                    '''
                }
            }
        }


        stage('6. Deploy Staging') {
            agent { label 'deploy' }

            steps {
                sh '''
                    set -eu

                    echo "Pulling Docker image..."
                    docker pull "$IMAGE:$TAG"

                    echo "Replacing staging container..."
                    docker rm -f react-multi-agent-staging || true

                    docker run -d \
                    --name react-multi-agent-staging \
                    --restart unless-stopped \
                    -p 127.0.0.1:3006:80 \
                    "$IMAGE:$TAG"

                    echo "Checking staging health..."

                    if ! curl \
                    --retry 15 \
                    --retry-delay 2 \
                    --retry-all-errors \
                    --connect-timeout 5 \
                    --max-time 10 \
                    -fsS \
                    http://127.0.0.1:3006/ \
                    -o /dev/null; then

                        echo "Staging health check failed"
                        docker ps -a \
                        --filter name=react-multi-agent-staging
                        docker logs --tail 100 react-multi-agent-staging
                        exit 1
                    fi

                    echo "STAGING DEPLOYMENT SUCCESS"
                '''
            }
        }


        stage('7. Production Approval & Deploy') {
            when {
                expression { params.DEPLOY_PRODUCTION }
            }

            agent { label 'deploy' }

            steps {
                timeout(time: 15, unit: 'MINUTES') {
                    input message: 'Deploy to AWS Production?',
                          ok: 'Approve'
                }

                sshagent(credentials: ['aws-production-ssh']) {
                    sh '''
                        set -eu

                        ssh -o BatchMode=yes \
                            -o StrictHostKeyChecking=yes \
                            "$AWS_USER@$AWS_HOST" \
                            "IMAGE='$IMAGE:$TAG' bash -se" <<'REMOTE'
                        set -eu

                        docker pull "$IMAGE"

                        docker rm -f react-prod-demo || true

                        docker run -d \
                          --name react-prod-demo \
                          -p 127.0.0.1:3007:80 \
                          "$IMAGE"

                        curl --retry 10 --retry-delay 2 \
                          --retry-connrefused -fsS \
                          http://127.0.0.1:3007/ \
                          -o /dev/null
REMOTE
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'CI/CD PIPELINE SUCCESS'
        }

        failure {
            echo 'PIPELINE FAILED'
        }

        aborted {
            echo 'PIPELINE ABORTED'
        }
    }
}
