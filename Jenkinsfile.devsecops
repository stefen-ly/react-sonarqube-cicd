
pipeline {
    agent none

    options {
        skipDefaultCheckout(true)
        timestamps()
    }

    parameters {
        booleanParam(
            name: 'DEPLOY_PRODUCTION',
            defaultValue: false,
            description: 'Enable AWS deployment after manual approval'
        )
    }

    environment {
        IMAGE = 'stefenly19/react-multi-agent'
        TAG = "${BUILD_NUMBER}"
        AWS_HOST = '52.221.253.109'
        AWS_USER = 'ubuntu'
    }

    stages {

        stage('1. Git Checkout') {
            agent { label 'build' }
            steps {
                checkout scm
                sh 'git log -1 --oneline'
            }
        }

        stage('2. Resolve Dependencies') {
            agent { label 'build' }
            steps {
                sh '''
                    set -eu
                    node --version
                    npm --version
                    npm ci
                '''
            }
        }


        stage('3. OWASP Dependency Check') {
            agent { label 'build' }

            steps {
                dependencyCheck(
                    odcInstallation: 'OWASP-Dependency-Check',
                    additionalArguments: '''
                        --project React-Multi-Agent
                        --scan .
                        --format XML
                        --format HTML
                        --out dependency-check-report
                        --exclude "**/node_modules/**"
                    ''',
                    stopBuild: true
                )
            }

            post {
                always {
                    dependencyCheckPublisher(
                        pattern: 'dependency-check-report/dependency-check-report.xml',
                        skipNoReportFiles: true
                    )

                    archiveArtifacts(
                        artifacts: 'dependency-check-report/*',
                        allowEmptyArchive: true
                    )
                }
            }
        }


        stage('4. SonarQube Scan') {
            agent { label 'build' }
            steps {
                withSonarQubeEnv('SonarQube-Agent-Lab') {
                    sh '''
                        sonar-scanner \
                          -Dsonar.projectKey=jenkins-multi-agent-lab \
                          -Dsonar.sources=src \
                          -Dsonar.host.url="$SONAR_HOST_URL" \
                          -Dsonar.token="$SONAR_AUTH_TOKEN"
                    '''
                }
            }
        }

        stage('5. Wait for Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('6. Build Image') {
            agent { label 'build' }
            steps {
                sh '''
                    set -eu

                    npm run build

                    docker build \
                      -f Dockerfile.multi-agent \
                      -t "$IMAGE:$TAG" \
                      .
                '''
            }
        }

        stage('7. Trivy Filesystem Scan') {
            agent { label 'build' }
            steps {
                sh '''
                    set -eu

                    mkdir -p trivy-reports .trivy-cache

                    docker run --rm \
                      --user "$(id -u):$(id -g)" \
                      -e HOME=/app \
                      -v "$PWD:/app" \
                      -w /app \
                      aquasec/trivy:0.76.2 \
                      fs \
                      --cache-dir /app/.trivy-cache \
                      --scanners vuln,secret \
                      --severity HIGH,CRITICAL \
                      --skip-dirs node_modules \
                      --skip-dirs .trivy-cache \
                      --skip-dirs dependency-check-report \
                      --exit-code 0 \
                      --format json \
                      --output trivy-reports/report.json \
                      .
                '''
            }
        }

        stage('8. Publish Trivy Filesystem Report') {
            agent { label 'build' }
            steps {
                sh 'test -s trivy-reports/report.json'

                archiveArtifacts(
                    artifacts: 'trivy-reports/report.json',
                    fingerprint: true
                )

                echo 'Trivy report archived successfully'
            }
        }

        stage('9. Trivy Security Gate') {
            agent { label 'build' }
            steps {
                sh '''
                    set -eu

                    python3 - <<'PY'
import json
import sys
from collections import Counter

with open("trivy-reports/report.json") as f:
    report = json.load(f)

counts = Counter()

for result in report.get("Results", []):
    for vulnerability in result.get("Vulnerabilities") or []:
        counts[vulnerability.get("Severity", "UNKNOWN")] += 1

    for secret in result.get("Secrets") or []:
        counts["SECRETS"] += 1

print("=== TRIVY SECURITY GATE ===", flush=True)
print("CRITICAL:", counts["CRITICAL"], flush=True)
print("HIGH:", counts["HIGH"], flush=True)
print("SECRETS:", counts["SECRETS"], flush=True)

if any(counts[key] > 0 for key in
       ("CRITICAL", "HIGH", "SECRETS")):
    print("SECURITY GATE FAILED", flush=True)
    sys.exit(1)

print("SECURITY GATE PASSED", flush=True)
PY
                '''
            }
        }

        stage('10. Push Docker Image') {
            agent { label 'build' }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-multi-agent',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        ORIGINAL_DOCKER_CONFIG="${DOCKER_CONFIG:-$HOME/.docker}"
                        TEMP_DOCKER_CONFIG="$(mktemp -d)"
                        trap 'rm -rf "$TEMP_DOCKER_CONFIG"' EXIT

                        printf '%s' "$DOCKER_PASS" | \
                          DOCKER_CONFIG="$TEMP_DOCKER_CONFIG" \
                          docker login \
                            -u "$DOCKER_USER" \
                            --password-stdin

                        DOCKER_CONFIG="$ORIGINAL_DOCKER_CONFIG" \
                          docker buildx inspect \
                          multi-agent-builder --bootstrap

                        if [ -d "$ORIGINAL_DOCKER_CONFIG/buildx" ]; then
                            cp -R "$ORIGINAL_DOCKER_CONFIG/buildx" \
                              "$TEMP_DOCKER_CONFIG/buildx"
                        fi

                        DOCKER_CONFIG="$TEMP_DOCKER_CONFIG" \
                          docker buildx build \
                            --builder multi-agent-builder \
                            --platform linux/amd64,linux/arm64 \
                            -f Dockerfile.multi-agent \
                            -t "$IMAGE:$TAG" \
                            --push .

                        echo "Multi-platform image pushed"
                    '''
                }
            }
        }

        stage('11. Deploy Staging') {
            agent { label 'deploy' }
            steps {
                sh '''
                    set -eu

                    docker pull "$IMAGE:$TAG"

                    docker rm -f react-multi-agent-staging || true

                    docker run -d \
                      --name react-multi-agent-staging \
                      --restart unless-stopped \
                      -p 127.0.0.1:3006:80 \
                      "$IMAGE:$TAG"

                    if ! curl \
                      --retry 15 \
                      --retry-delay 2 \
                      --retry-all-errors \
                      --connect-timeout 5 \
                      --max-time 10 \
                      -fsS \
                      http://127.0.0.1:3006/ \
                      -o /dev/null; then

                        docker ps -a \
                          --filter name=react-multi-agent-staging

                        docker logs --tail 100 \
                          react-multi-agent-staging

                        exit 1
                    fi

                    echo "STAGING DEPLOYMENT SUCCESS"
                '''
            }
        }

        stage('12. Production Approval & Deploy') {
            when {
                expression { params.DEPLOY_PRODUCTION }
            }

            agent { label 'deploy' }

            steps {
                timeout(time: 15, unit: 'MINUTES') {
                    input message: 'Deploy to AWS Production?',
                          ok: 'Approve'
                }

                sshagent(credentials: ['aws-production-ssh']) {
                    sh '''
                        set -eu

                        ssh -o BatchMode=yes \
                            -o StrictHostKeyChecking=yes \
                            "$AWS_USER@$AWS_HOST" \
                            "IMAGE='$IMAGE:$TAG' bash -se" <<'REMOTE'
set -eu

docker pull "$IMAGE"

docker rm -f react-prod-demo || true

docker run -d \
  --name react-prod-demo \
  --restart unless-stopped \
  -p 127.0.0.1:3007:80 \
  "$IMAGE"

curl \
  --retry 15 \
  --retry-delay 2 \
  --retry-all-errors \
  -fsS \
  http://127.0.0.1:3007/ \
  -o /dev/null

REMOTE
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'CI/CD PIPELINE SUCCESS'
        }

        failure {
            echo 'CI/CD PIPELINE FAILED'
        }

        aborted {
            echo 'CI/CD PIPELINE ABORTED'
        }
    }
}
